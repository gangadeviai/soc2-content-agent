# Copy to .env for local development. Production values come from the secrets manager.
AGENT_ENV=dev
ANTHROPIC_API_KEY=            # leave empty to use `ant auth login` profile / WIF

AGENT_MODEL_ID=claude-opus-5-5
AGENT_MODEL_EFFORT=high
AGENT_ENABLE_REFUSAL_FALLBACK=true
AGENT_ZDR_CONTRACT_CONFIRMED=false   # must be true in prod (see compliance/VENDOR_SUBPROCESSOR_ASSESSMENT.md)

AGENT_PROMPT_VERSION=1.1.0
AGENT_DATABASE_URL=sqlite:///./agent.db
# AGENT_RAG_DATABASE_URL=postgresql://kb_readonly:***@db:5432/kb   # SELECT-only role

# Brand crawl: targets come from tenants/brands.yaml, never from the API.
AGENT_CRAWL_MAX_BYTES_PER_PAGE=2000000
AGENT_BRAND_CONTEXT_MAX_CHARS=60000

# AGENT_AUDIT_S3_BUCKET=content-agent-audit-worm      # Object Lock COMPLIANCE mode
AGENT_AUDIT_RETENTION_DAYS=2555

AGENT_JWT_SECRET=dev-only-change-me
AGENT_JWT_ISSUER=https://idp.example.com/
AGENT_JWT_AUDIENCE=content-agent

# WordPress publishing - one application password per tenant, for a WP user holding
# only the Author/Editor role on that brand's site. Read ONLY inside the publish path.
# AGENT_WP_USER__CLIENT_A=content-agent
# AGENT_WP_APP_PASSWORD__CLIENT_A=xxxx xxxx xxxx xxxx xxxx xxxx
# AGENT_WP_USER__CLIENT_B=content-agent
# AGENT_WP_APP_PASSWORD__CLIENT_B=

AGENT_DRAFT_RETENTION_DAYS=180
